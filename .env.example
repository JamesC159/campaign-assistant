# Copy to .env to override defaults. Never commit .env.
# Every value is optional for local dev; the values below are the defaults.
# Keep comments on their own lines (Make and docker compose both read this file).

# dev | prod
APP_ENV=dev
# debug | info | warn | error
LOG_LEVEL=info
HTTP_ADDR=127.0.0.1:8090
# Public URL of the web app (used in emailed sign-in links).
APP_URL=http://127.0.0.1:5173

# Host port for the docker compose Postgres. Keep DATABASE_URL in sync.
DB_PORT=5433
DATABASE_URL=postgres://campaign:campaign@127.0.0.1:5433/campaign?sslmode=disable
# The API and worker SET ROLE to this restricted role so row-level security applies.
# In production, DATABASE_URL must log in as a non-superuser member of it.
DB_APP_ROLE=campaign_app
WORKER_CONCURRENCY=2

# mock = no AWS account needed. aws = real Bedrock/Transcribe/S3/SES.
PROVIDER=mock
AWS_REGION=us-east-1

# Required when PROVIDER=aws: Bedrock model or inference-profile IDs.
# STRONG: extraction + contradiction checks (needs forced tool use). FAST: recaps + tiebreaks.
BEDROCK_MODEL_STRONG=
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_EMBED=amazon.titan-embed-text-v2:0

# Required when PROVIDER=aws: an SES-verified sender address.
# With PROVIDER=mock, email goes to an in-memory mailbox at /dev/mailbox.
MAIL_FROM=
